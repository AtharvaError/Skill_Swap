# PostgreSQL. DATABASE_URL is used by the running app (a pooled URL is fine).
# DATABASE_URL_UNPOOLED is optional: when set, Prisma migrations use it, which
# Neon needs because migrations cannot run through its connection pooler.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED=

PORT=3001
NODE_ENV=development

# Where the web app runs. ALLOWED_ORIGIN is the CORS allow-list (comma-separated
# for more than one origin); FRONTEND_URL is where OAuth redirects come back to.
ALLOWED_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth cookie SameSite policy: strict | lax | none.
# Defaults to "lax" in development and "none" in production, which is what a
# web app and API on different sites (e.g. Vercel + Render) need.
# COOKIE_SAMESITE=

# Secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start while these hold placeholder values.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Comma-separated emails that can open the admin panel (/admin): moderate
# reports, suspend accounts and fulfil reward requests.
ADMIN_EMAILS=

# Optional: email via Resend (https://resend.com), used for password reset
# links. Without a key, development prints the email to the API console and
# production cannot send it.
RESEND_API_KEY=
MAIL_FROM=SkillSwap <onboarding@resend.dev>

# Optional: Google Calendar. When all three are set, users can connect their
# calendar and scheduled sessions get an event with a Meet link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/calendar/oauth2callback

# Optional: Daily.co. When set, sessions get an in-app video room. Without it,
# sessions fall back to a Google Meet link (if Calendar is connected) or a
# meet.jit.si room that opens in a new tab.
DAILY_API_KEY=
