DATABASE_URL="file:./dev.db"
PORT=3001
BACKEND_URL="http://localhost:3001"
NODE_ENV=development

# Frontend origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:3000

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WARNING: Server will refuse to start if these contain placeholder values!
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET

# CSRF secret — also required; generate the same way
CSRF_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Daily.co
DAILY_API_KEY=
